# dependencies
/node_modules
.pnpm-store

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# environment variables — NEVER commit secrets (CLAUDE.md §3.7)
.env
.env*.local
.env.development
.env.production
!.env.example

# prisma
/prisma/*.db

# testing
/coverage

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# logs
npm-debug.log*
pnpm-debug.log*

# local agent/session state — settings.json(팀 자동승인 정책, CLAUDE.md §7-B 정본)만 추적.
# settings.local.json은 머신별(psql 경로 등)이라 제외 유지.
.claude/*
!.claude/settings.json

# playwright artifacts
/test-results/
/playwright-report/
